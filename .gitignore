# Camada Bronze (dados locais, preservamos apenas estrutura vazia)
/data/bronze/
!data/bronze/.gitkeep

# Camada Silver
/data/silver/
!data/silver/.gitkeep

# Volume de dados do MinIO (runtime do container, inclui arquivos com dono/
# permissões do uid interno do container e não deve ser versionado)
/data/minio/

# Artefatos do Python
__pycache__/
*.py[cod]

# Ambientes virtuais e variáveis de ambiente
.env
venv/

# Cache local do scriptLattes (currículos baixados, retomável entre execuções)
/.cache/

docker-compose.yml

data/