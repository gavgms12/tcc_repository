# Copie para .env (o .env real não é versionado) e ajuste os valores.
#
# Endpoint e credenciais do MinIO. O usuário/senha também são usados como
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD pelo container do MinIO (docker-compose.yml).
# http://localhost:9010 é o endpoint visto do HOST (fora do Docker); dentro do
# container do Airflow o docker-compose sobrescreve para http://tcc-minio:9000.
MINIO_ENDPOINT=http://localhost:9010
MINIO_ACCESS_KEY=troque-este-usuario
MINIO_SECRET_KEY=troque-esta-senha
MINIO_REGION=us-east-1

# UID do seu usuário no host (comando `id -u`), para o container do Airflow
# criar arquivos com o mesmo dono nos volumes montados.
AIRFLOW_UID=1000

# Endpoint e credenciais do Qdrant Cloud 
# Crie um Cluster em https://cloud.qdrant.io/

QDRANT_URL=coloque_sua_url
QDRANT_API_KEY=coloque_sua_api_key

# Opcionais (valores padrão entre parênteses)
# TZ_COLETA=America/Sao_Paulo   # fuso usado na data das pastas da Bronze
# BRONZE_DATA=AAAAMMDD          # fixa a pasta da Bronze lida pela Silver (padrão: a mais recente)
# LATTES_CACHE_DIAS=30          # validade do cache dos currículos Lattes (0 = nunca expira)
# ANO_MINIMO=                   # ano inicial das produções/trabalhos (padrão: ano atual - 10)
