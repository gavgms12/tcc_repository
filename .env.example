# Copie para .env (o .env real não é versionado) e troque todos os valores "troque-...".
# Gerar segredos aleatórios:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Gerar a AIRFLOW_FERNET_KEY:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# --------------------------------------------------------------------------- #
# MinIO
# --------------------------------------------------------------------------- #
# Administrador do MinIO: só para o console e para o serviço minio-init.
MINIO_ROOT_USER=troque-admin
MINIO_ROOT_PASSWORD=troque-esta-senha-admin

# Usuário de serviço do pipeline (criado pelo minio-init, acesso só aos buckets
# das camadas). É o que os scripts e o Airflow usam.
MINIO_ACCESS_KEY=pipeline
MINIO_SECRET_KEY=troque-esta-senha-pipeline

# Endpoint visto do HOST (scripts rodados fora do Docker). Dentro dos
# containers o docker-compose usa http://minio:9000.
MINIO_ENDPOINT=http://localhost:9010
MINIO_REGION=us-east-1

# --------------------------------------------------------------------------- #
# Airflow
# --------------------------------------------------------------------------- #
# UID do seu usuário no host (`id -u`): arquivos criados pelo container nos
# volumes montados ficam com o seu usuário como dono.
AIRFLOW_UID=1000

# Login da interface (usuário admin).
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha

AIRFLOW_FERNET_KEY=troque-pela-chave-fernet
AIRFLOW_JWT_SECRET=troque-este-segredo
AIRFLOW_API_SECRET_KEY=troque-este-segredo

# Banco de metadados do Airflow (container postgres).
POSTGRES_USER=airflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=airflow

# --------------------------------------------------------------------------- #
# Qdrant Cloud (sistema de busca; alimentado pela DAG indexacao_qdrant)
# --------------------------------------------------------------------------- #
# Qdrant Cloud: URL e API key do cluster (https://cloud.qdrant.io/). É o mesmo
# cluster que a API de busca consulta.
QDRANT_URL=https://seu-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=troque-pela-api-key

# INSTALL_BUSCA=true            # false: imagem sem torch/BGE-M3 (sem indexação)

# --------------------------------------------------------------------------- #
# Opcionais do pipeline (padrão entre parênteses)
# --------------------------------------------------------------------------- #
# TZ_COLETA=America/Sao_Paulo   # fuso usado na data das pastas da Bronze
# BRONZE_DATA=AAAAMMDD          # fixa a pasta da Bronze lida pela Silver (padrão: a mais recente)
# LATTES_CACHE_DIAS=30          # validade do cache dos currículos Lattes (0 = nunca expira)
# ANO_MINIMO=                   # ano inicial das produções/trabalhos (padrão: ano atual - 10)
# MINIO_BRONZE_BUCKET=bronze  MINIO_SILVER_BUCKET=silver  MINIO_GOLD_BUCKET=gold
